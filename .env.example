# OVERLORD model execution: OpenCode CLI only.
# Keep OPENCODE_FREE_MODELS empty until each exact provider/model ID is
# verified in the current OpenCode catalogue as zero input and output price.
# The gateway enforces this explicit allowlist and rejects non-zero reported
# spend; the operator must re-check catalogue pricing before allowlisting.
LLM_PROVIDER=opencode
DEFAULT_MODEL=auto
OPENCODE_CLI=opencode
OPENCODE_AGENT=overlord-model
OPENCODE_FREE_MODELS=
OPENCODE_DEFAULT_MODEL=
OPENCODE_FAST_MODEL=
OPENCODE_STANDARD_MODEL=
OPENCODE_REASONING_MODEL=
OPENCODE_TIMEOUT_MS=90000
OPENCODE_MAX_COST_USD=0
# OPENCODE_VARIANT=
# OPENCODE_WORKDIR=

# SECURITY FIRST: every server fails closed without this. Generate with:
#   python agent-os/python/make_token.py
# Rotate by re-running (overwrites) + restarting all servers.
AGENT_OS_TOKEN=
# Extra scoped tokens "tok:role,..." (viewer, operator, admin).
# Worker credentials are separate and cannot use operator/admin write routes.
AGENT_OS_TOKENS=
# Dedicated worker identity; cannot create workflows, change config, or redrive DLQ.
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_OS_WORKER_TOKEN=
# Fixed-window rate limit (requests/min per token, 429 past it).
RATE_LIMIT_RPM=120
# Opt-in TLS (all servers): paths to PEM cert+key, e.g. from
#   python agent-os/security/gen-local-ca.py
# Clients verify with the CA file. Default off = plain localhost HTTP.
TLS_CERT=
TLS_KEY=

# Single gateway endpoint used by supervisor, engine and studio.
GATEWAY_PORT=20129
GATEWAY_URL=http://localhost:20129

# Single memory: shared SQLite (saber logs + loom memories). JSON files are export/cache only.
MEMORY_PORT=20130
MEMORY_URL=http://localhost:20130
AGENT_OS_DB=agent-os/.data/agent-os.db
DATAOS_DB=.data/agent-os.db
DATAOS_BLOB=.data/blobs

# Optional PostHog lifecycle telemetry. Leave empty to disable.
# Events contain service/status metadata only; no prompts, outputs or run IDs.
# Default project in this setup uses the US ingestion region.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# OpenTelemetry / Datadog configuration is intentionally not enabled until
# a real OTLP collector endpoint and service identity are provisioned.
OTEL_SERVICE_NAME=overlord-supervisor
OTEL_EXPORTER_OTLP_ENDPOINT=
DD_SITE=datadoghq.com
DD_API_KEY=

# Legacy compatibility flag only. It is ignored; JS transforms remain disabled
# until a separately supervised OS/container/microVM executor is implemented.
STUDIO_ALLOW_JS=0